{
  "name": "secomp2026-monolith",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch backend/src/server.ts",
    "build": "tsc && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/server/backend/src/server.js",
    "preview": "vite preview",
    "test": "vitest run",
    "test:all": "vitest run",
    "test:backend": "vitest run backend/tests",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
