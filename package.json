    "@fastify/static": "^8.1.1",
    "@prisma/client": "^5.22.0",
    "@sentry/node": "^8.47.0",
    "@studio-freight/lenis": "^1.0.42",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "@tanstack/react-query": "^5.62.8",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.34.4",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.5",
    "framer-motion": "^11.15.0",
    "immer": "^11.1.18",
