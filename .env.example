# ==============================================================================
# SECOMP 2026 — Variáveis de Ambiente (Template Seguro)
# ==============================================================================

# Aplicação & Servidor
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Banco de Dados PostgreSQL (Local ou Docker)
DATABASE_URL=postgresql://secomp_admin:secomp_pass@localhost:5432/secomp2026_db?schema=public

# Cache & Background Queues (Redis 7+)
REDIS_URL=redis://localhost:6379

# Segurança & Criptografia (Gere chaves seguras de 64 caracteres hexadecimais em produção)
# Exemplo: openssl rand -hex 32
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_SECRET=secomp-2026-super-secure-jwt-token-secret-key-32chars
COOKIE_SECRET=secomp-2026-cookie-signature-secret-key-must-be-long

# Chave de Assinatura Digital dos Certificados HMAC-SHA256
CERTIFICATE_SIGN_SECRET=secomp-2026-hmac-sha256-certificate-sign-secret

# Observabilidade & Sentry (Opcional em desenvolvimento)
SENTRY_DSN=
